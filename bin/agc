#!/usr/bin/env python3
import os
import sys
import shutil
import subprocess
import signal

VERSION = "2.1.245"
PROJECT_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, PROJECT_DIR)

from src.server import start_server

def launch_gui():
    server, port = start_server(0)
    url = f"http://127.0.0.1:{port}"

    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("WebKit2", "4.1")
        from gi.repository import Gtk, WebKit2, GLib

        win = Gtk.Window(title="Antigravity")
        win.set_default_size(1220, 820)
        win.set_position(Gtk.WindowPosition.CENTER)

        webview = WebKit2.WebView()
        settings = webview.get_settings()
        settings.set_enable_developer_extras(False)
        settings.set_javascript_can_open_windows_automatically(False)

        webview.load_uri(url)
        win.add(webview)
        win.connect("destroy", Gtk.main_quit)

        win.show_all()
        Gtk.main()
    except KeyboardInterrupt:
        pass
    except Exception:
        chrome_path = shutil.which("google-chrome") or shutil.which("chromium") or shutil.which("chromium-browser")
        if chrome_path:
            proc = subprocess.Popen([
                chrome_path,
                f"--app={url}",
                "--class=Antigravity",
                f"--user-data-dir={os.path.expanduser('~/.cache/agc-profile')}"
            ])
            proc.wait()
        else:
            import webbrowser
            webbrowser.open(url)
            try:
                signal.pause()
            except (KeyboardInterrupt, SystemExit):
                pass
    finally:
        try:
            server.shutdown()
        except Exception:
            pass

def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1]
        if arg in ("-v", "--version", "version"):
            print(f"Antigravity Claude-Style Wrapper v{VERSION}")
            sys.exit(0)
        if arg in ("-h", "--help", "help"):
            print("Usage: agc [options]")
            print("Starts the Antigravity desktop graphical interface.")
            print("")
            print("Options:")
            print("  --cli                 Run in terminal CLI mode")
            print("  -v, --version         Show version")
            print("  -h, --help            Show help")
            sys.exit(0)
        if arg == "--cli":
            agy_bin = shutil.which("agy") or os.path.expanduser("~/.local/bin/agy")
            os.execv(agy_bin, [agy_bin] + sys.argv[2:])

    launch_gui()

if __name__ == "__main__":
    main()
